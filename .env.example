# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT Authentication Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# Production & Infrastructure Configuration
# Database Connection (PostgreSQL)
DATABASE_URL="postgres://postgres:postgres_password@localhost:5432/enterprise_erp"

# Redis Cache & Queue Connection URL
# Format: redis://[[username]:password@]host[:port][/database_number]
# Default local: redis://localhost:6379/0
# Docker Compose: redis://:redis_password@redis:6379/0
# Cloud/Managed (Upstash/Redis Labs/Aiven/AWS ElastiCache): rediss://default:your_secret_token@your-redis-host.com:6379/0
REDIS_URL="redis://localhost:6379/0"

SESSION_SECRET="production_session_secret_minimum_32_characters"
NODE_ENV=production
